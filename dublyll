#include <iostream>
using namespace std;

class Node {
public:
    int data;
    Node* next;
    Node* prev;

    Node(int val) {
        data = val;
        next = prev = nullptr;
    }
};

class doubleLinkedList {
    Node* head;
    Node* tail;

public:
    doubleLinkedList() {
        head = tail = nullptr;
    }

    // insert at front
    void push_front(int val) {
        Node* newNode = new Node(val);

        if (head == nullptr) {
            head = tail = newNode;
        } else {
            newNode->next = head;
            head->prev = newNode;
            head = newNode;
        }
    }

    // insert at back
    void push_back(int val) {
        Node* newNode = new Node(val);

        if (tail == nullptr) {   // list empty
            head = tail = newNode;
        } else {
            newNode->prev = tail;
            tail->next = newNode;
            tail = newNode;
        }
    }

    // print list
    void print() {
        Node* temp = head;
        while (temp != nullptr) {
            cout << temp->data << " <=> ";
            temp = temp->next;
        }
        cout << "NULL";
    }
};

int main() {
    doubleLinkedList dll;

    dll.push_back(1);
    dll.push_back(2);
    dll.push_back(3);

    dll.print();   // Output: 1 <=> 2 <=> 3 <=> NULL

    return 0;
}
