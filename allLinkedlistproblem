#include<iostream>
using namespace std;

class Node {                          // node class
public:
    int data;
    Node* next;

    Node(int val) {               // constructor
        data = val;
        next = nullptr;
    }
};

class List {              // linked list class
    Node* head;
    Node* tail;

public:                      // constructor
    List() {
        head = nullptr;
        tail = nullptr;
    }
 
    void push_front(int val) {                      // inserts a node with value 'val' at the front
        Node* newNode = new Node(val);
        if (head == nullptr) {
            head = tail = newNode;
        } else {
            newNode->next = head;
            head = newNode;
        }
    }

    void push_back(int val) {                     // inserts a node with value 'val' at the back
        Node* newNode = new Node(val);
        if (tail == nullptr) {
            head = tail = newNode;
        } else {
            tail->next = newNode;
            tail = newNode;
        }
    }

    void pop_front() {                  // removes a node from the front
        if (head == nullptr) {
            cout << "LL is empty" << endl;
            return;
        }
        Node* temp = head;
        head = head->next;
        delete temp;

        if (head == nullptr)   // list became empty
            tail = nullptr;
    }

    void pop_back() {                 // removes a node from the back
        if (head == nullptr) {
            cout << "LL is empty" << endl;
            return;
        }

        if (head == tail) {   // only one node
            delete head;
            head = tail = nullptr;
            return;
        }

        Node* temp = head;
        while (temp->next != tail) {
            temp = temp->next;
        }
        delete tail;
        tail = temp;
        tail->next = nullptr;
    }

    void insert(int val, int pos) {               // inserts a node with value 'val' at position 'pos'
        if (pos < 0) {
            cout << "Invalid position" << endl;
            return;
        }

        if (pos == 0) {
            push_front(val);
            return;
        }

        Node* temp = head;
        for (int i = 0; i < pos - 1 && temp != nullptr; i++) {
            temp = temp->next;
        }

        if (temp == nullptr) {
            cout << "Position out of range" << endl;
            return;
        }

        Node* newNode = new Node(val);
        newNode->next = temp->next;
        temp->next = newNode;

        if (newNode->next == nullptr)
            tail = newNode;
    }

    void PrintLL() {          // prints the linked list
        Node* temp = head;
        while (temp != nullptr) {
            cout << temp->data << "->";
            temp = temp->next;
        }
        cout << "NULL" << endl;
    }

    int search(int key){          // returns index of key if found else -1   (Searching in linked list)
        Node*temp = head;
        int idx = 0;
        while(temp != nullptr){
            if(temp->data == key){
                return idx;
            }
            temp = temp->next;
            idx++;
        }
        return -1;
    }
};

int main() {
    List ll;
    ll.push_front(1);
    ll.push_front(2);
    ll.push_front(3);
    ll.PrintLL();

    ll.pop_front();
    ll.PrintLL();

    ll.insert(4, 0);
    ll.PrintLL();

    ll.pop_back();
    ll.PrintLL();

     cout<<"ll.search(2): "<<ll.search(2)<<endl;

    ll.push_back(4);
    ll.PrintLL();

    return 0;
}


