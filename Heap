#include<iostream>
using namespace std;

class heapimpl {
public:
    int* arr;
    int size;
    int capacity;

    heapimpl(int capacity) {
        arr = new int[capacity + 1];
        size = 0;
        this->capacity = capacity;
    }

    void minHeap(int val) {
        if (size == capacity) {
            cout << "Heap is full" << endl;
            return;
        }

        size++;
        arr[size] = val;

        int i = size;
        int parent = i / 2;

        while (i > 1 && arr[parent] > arr[i]) {
            swap(arr[i], arr[parent]);
            i = parent;
            parent = i / 2;
        }
    }

    
    void printLevelWise() {
        int i = 1;
        int level = 1;

        while (i <= size) {
            int levelSize = 1 << (level - 1); 

            for (int j = 0; j < levelSize && i <= size; j++) {
                cout << arr[i] << " ";
                i++;
            }
            cout << endl;
            level++;
        }
    }

    void printHeap() {
        for (int i = 1; i <= size; i++) {
            cout << arr[i] << " ";
        }
        cout << endl;
    }
};

int main() {
    heapimpl h(4);
    h.minHeap(17);
    h.minHeap(3);
    h.minHeap(19);
    h.minHeap(2);

    h.printLevelWise(); 
    return 0;
}
